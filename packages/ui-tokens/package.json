{
  "name": "@repair-god/ui-tokens",
  "version": "0.1.0",
  "description": "Shared design tokens for Repair God platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./colors": {
      "types": "./dist/colors.d.ts",
      "import": "./dist/colors.js",
      "default": "./dist/colors.js"
    },
    "./typography": {
      "types": "./dist/typography.d.ts",
      "import": "./dist/typography.js",
      "default": "./dist/typography.js"
    },
    "./spacing": {
      "types": "./dist/spacing.d.ts",
      "import": "./dist/spacing.js",
      "default": "./dist/spacing.js"
    },
    "./gradients": {
      "types": "./dist/gradients.d.ts",
      "import": "./dist/gradients.js",
      "default": "./dist/gradients.js"
    },
    "./shadows": {
      "types": "./dist/shadows.d.ts",
      "import": "./dist/shadows.js",
      "default": "./dist/shadows.js"
    },
    "./glass": {
      "types": "./dist/glass.d.ts",
      "import": "./dist/glass.js",
      "default": "./dist/glass.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true,force:true})\""
  },
  "devDependencies": {
    "@repair-god/tsconfig": "workspace:*",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.0"
  }
}
